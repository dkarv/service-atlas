{
  "name": "service-atlas",
  "image": "dunglas/frankenphp:1-php8.5",
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client"
      ]
    }
  },
  "portsAttributes": {
    "8080": {
      "label": "PHP application",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "frankenphp run --config backend/Caddyfile"
}
