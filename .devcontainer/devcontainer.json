{
  "name": "service-atlas",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Python application",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "python backend/main.py",
  "remoteUser": "vscode"
}
