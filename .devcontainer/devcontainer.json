{
  "name": "service-atlas",
  "image": "mcr.microsoft.com/devcontainers/java:25",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installGradle": true
    }
  },
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin"
      ]
    }
  },
  "portsAttributes": {
    "8080": {
      "label": "Kotlin application",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "gradle run",
  "remoteUser": "vscode"
}
