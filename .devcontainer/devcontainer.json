{
  "name": "service-atlas",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Node.js application",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "node backend/server.mjs",
  "remoteUser": "node"
}
